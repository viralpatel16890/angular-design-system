{
  "name": "angular-design-system-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build showcase",
    "build:vercel": "ng build showcase --configuration production && ng build consumer-demo --configuration production --base-href /consumer/ && node scripts/copy-consumer-static.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/axe-a11y.spec.ts",
    "e2e:update-snapshots": "playwright test --update-snapshots",
    "playwright:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:styles": "stylelint \"projects/angular-ds/src/lib/components/**/*.scss\"",
    "lint:styles:fix": "stylelint \"projects/angular-ds/src/lib/components/**/*.scss\" --fix",
    "build:lib": "ng build angular-ds && node scripts/patch-exports.js",
    "tokens:build": "style-dictionary build --config style-dictionary.config.js",
    "tokens:check": "style-dictionary build --config style-dictionary.config.js && git diff --exit-code design-tokens/build/",
    "tokens:contrast": "node scripts/check-contrast.js",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.2",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "^1.52.0",
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/angular": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "husky": "^9.1.7",
    "jsdom": "^29.0.0",
    "ng-packagr": "^22.0.0",
    "prettier": "^3.8.1",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.0.0",
    "stylelint": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
