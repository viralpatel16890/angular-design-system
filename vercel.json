{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist/showcase/browser",
  "rewrites": [
    { "source": "/consumer/(.*)", "destination": "/consumer/index.html" },
    { "source": "/storybook/(.*)", "destination": "/storybook/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
